{
  "name": "fronty",
  "version": "0.1.0",
  "description": "Copy-paste React components that bring old UI back to life, from 1984 Mac to 2026 liquid glass.",
  "license": "MIT",
  "author": "Lazizbek Ravshanov",
  "type": "module",
  "bin": {
    "fronty": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "registry"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.cli.json",
    "tokens": "node scripts/build-tokens.ts",
    "icons": "node scripts/build-icons.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
